{
  "name": "web-saas-starter",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "setup": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "node checks/run.mjs",
    "shots": "node scripts/shots.mjs",
    "seed": "tsx scripts/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.9",
    "@paddle/paddle-js": "1.6.5",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "next": "16.4.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.1",
    "typescript-for-lint": "npm:typescript@6.0.3",
    "vitest": "5.0.4"
  },
  "overrides": {
    "typescript": "$typescript",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
