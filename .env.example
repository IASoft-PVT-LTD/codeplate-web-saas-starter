# Copy to .env.local for development (never commit .env files).
# Everything is optional in development: the app runs with an embedded database
# and the console mailer, and the billing page offers a plan simulator.

# --- App -------------------------------------------------------------------------
# Public URL of the site (used in emails and auth callbacks).
APP_URL=http://localhost:3000
# 32+ random characters. REQUIRED in production. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Comma-separated emails that can open /admin.
ADMIN_EMAILS=

# --- Database -----------------------------------------------------------------------
# Unset or "pglite:<folder>" = embedded Postgres on disk (default pglite:.data/pglite).
# Production: a real Postgres, e.g. postgres://user:pass@host:5432/db (Neon, Supabase, RDS...).
# REQUIRED in production: the app refuses to start on the embedded database there.
DATABASE_URL=

# --- Email ------------------------------------------------------------------------------
# "console" prints emails and keeps them at /dev/outbox. "resend" sends them for real.
EMAIL_PROVIDER=console
RESEND_API_KEY=
EMAIL_FROM="Launchpad <hello@example.com>"

# --- Paddle (docs/recipes/set-up-paddle.md) ------------------------------------------------
# "sandbox" while testing, "production" when live.
NEXT_PUBLIC_PADDLE_ENV=sandbox
# Client-side token (Paddle → My account → Settings → Authentication).
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
# Server API key (same page). Secret.
PADDLE_API_KEY=
# Webhook secret (Paddle → Events → Notifications → your destination). Secret.
PADDLE_WEBHOOK_SECRET=
# Price ids for the paid plans in src/config/plans.ts.
NEXT_PUBLIC_PADDLE_PRICE_PRO=
NEXT_PUBLIC_PADDLE_PRICE_TEAM=
